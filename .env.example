# Copy to .env (gitignored) to change the port the portal serves on. Default 8200; Start-Portal -Port overrides.
PORTAL_PORT=8200
# The stock feeds of compose.yaml (Invoke-Build Feeds; docs/design.md 40) serve on 127.0.0.1:8201 (registry) and
# 127.0.0.1:8202 (NuGet), the URLs portal.base.yaml names. Feeds writes these two secrets into .env, random, the first
# time it runs; the portal reads PORTAL_NUGET_KEY when it pushes to cards-nuget.
# PORTAL_NUGET_KEY=
# PORTAL_POSTGRES_PASSWORD=
